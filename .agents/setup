#!/usr/bin/env bash
set -euo pipefail

if [[ "$(node --version)" != "v26.10.0" ]]; then
  sudo npm install --global node@26.10.0
fi

# Oxlint's JS-plugin allocator reserves a large sparse address range.
# This orb-only kernel setting permits that reservation without allocating RAM.
bash .agents/resume
npm ci --no-audit --no-fund
